extends ../layout.pug

block content

  - function tiempoRelativo(fecha) {
  -   const ahora = new Date();
  -   const publicada = new Date(fecha);
  -   const diferencia = ahora - publicada;
  -   const minutos = Math.floor(diferencia / 60000);
  -   const horas = Math.floor(minutos / 60);
  -   const dias = Math.floor(horas / 24);
  -   if (minutos < 1) return 'Recién';
  -   if (minutos < 60) return `Hace ${minutos} min`;
  -   if (horas < 24) return `Hace ${horas} h`;
  -   if (dias < 7) return `Hace ${dias} día${dias > 1 ? 's' : ''}`;
  -   return publicada.toLocaleDateString('es-AR');
  - }

  .mensajes-container

    .mensajes-card

      if otroUsuario

        h1 Conversación con #{otroUsuario.nombre}

      else

        h1 Mensajes recibidos

      if mensajes && mensajes.length > 0

        each mensaje in mensajes

          article.mensaje-item

            if mensaje.emisor && mensaje.emisor.id === currentUser.id

              p
                strong Vos:
                |  #{mensaje.contenido}

            else

              p
                strong #{mensaje.emisor ? mensaje.emisor.nombre : 'Usuario'}:
                |  #{mensaje.contenido}

            if mensaje.createdAt

              small.fecha-mensaje
                | #{tiempoRelativo(mensaje.createdAt)}

            if !otroUsuario && mensaje.emisor

              .acciones-mensaje

                a.btn(
                  href=`/mensajes/${mensaje.emisor.id}`
                )
                  | Responder mensaje

            hr

      else

        if otroUsuario

          p.sin-mensajes
            | Todavía no hay mensajes en esta conversación.

        else

          p.sin-mensajes
            | No tenés mensajes recibidos.

      if otroUsuario

        h2 Enviar mensaje

        form(
          action=`/mensajes/${otroUsuario.id}`
          method='POST'
        )

          textarea.mensaje-textarea(
            name='contenido'
            rows='4'
            placeholder='Escribí tu mensaje...'
            required
          )

          .acciones-mensaje

            button.btn(
              type='submit'
            )
              | Enviar mensaje

      .acciones-mensaje

        a.btn(href='/')
          | Volver al inicio