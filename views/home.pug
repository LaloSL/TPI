extends layout.pug

block content

  - function tiempoRelativo(fecha) {
  -   const ahora = new Date();
  -   const publicada = new Date(fecha);
  -   const diferencia = ahora - publicada;
  -   const minutos = Math.floor(diferencia / 60000);
  -   const horas = Math.floor(minutos / 60);
  -   const dias = Math.floor(horas / 24);
  -   if (minutos < 1) return 'Recién publicado';
  -   if (minutos < 60) return `Hace ${minutos} min`;
  -   if (horas < 24) return `Hace ${horas} h`;
  -   if (dias < 7) return `Hace ${dias} día${dias > 1 ? 's' : ''}`;
  -   return publicada.toLocaleDateString('es-AR');
  - }

  section.home-header
    h1 Fotaza

  section.buscador-home
    form(action='/' method='GET')
      div.campo-busqueda
        input#buscar(
          type='text'
          name='buscar'
          placeholder='Buscar por descripción, usuario o etiqueta...'
          value=busqueda ? busqueda.buscar : ''
        )

      div.acciones-busqueda
        button.btn(type='submit')
          | Buscar

        if busqueda && busqueda.buscar
          a.limpiar-busqueda(href='/')
            | Limpiar búsqueda

  h2 Mirá las últimas publicaciones

  if publicaciones && publicaciones.length > 0

    each publicacion in publicaciones

      article.publicacion

        div.cabecera-publicacion
          h3= publicacion.Usuario ? publicacion.Usuario.nombre : 'Usuario desconocido'

          if currentUser && publicacion.Usuario
            if currentUser.id !== publicacion.usuarioId

              - const yaSigue = siguiendo && siguiendo.includes(publicacion.Usuario.id)

              if yaSigue
                form(action=`/usuarios/dejar-seguir/${publicacion.Usuario.id}` method='POST')
                  button.btn.btn-sm.btn-danger(type='submit')
                    | Dejar de seguir
              else
                form(action=`/usuarios/seguir/${publicacion.Usuario.id}` method='POST')
                  button.btn.btn-sm.btn-primary(type='submit')
                    | Seguir

        if publicacion.descripcion
          p.descripcion-publicacion= publicacion.descripcion

        if publicacion.Archivos && publicacion.Archivos.length > 0

          each archivo in publicacion.Archivos

            if archivo.tipo && archivo.tipo.startsWith('image')
              if archivo.tieneCopyright && archivo.rutaProtegida
                img(src=archivo.rutaProtegida alt='Imagen protegida')
              else
                img(src=archivo.ruta alt='Imagen original')

            else if archivo.tipo && archivo.tipo.startsWith('video')
              video(controls)
                source(src=archivo.ruta type=archivo.tipo)

            else
              p.text-muted
                | Archivo no compatible

            - const cantidadValoraciones = archivo.Valoracions ? archivo.Valoracions.length : 0
            - const sumaValoraciones = archivo.Valoracions ? archivo.Valoracions.reduce((total, v) => total + v.valor, 0) : 0
            - const promedioValoraciones = cantidadValoraciones > 0 ? Math.round(sumaValoraciones / cantidadValoraciones) : 0
            - const cantidadLikes = publicacion.Likes ? publicacion.Likes.length : 0

            div.info-publicacion
              if cantidadValoraciones > 0
                span
                  | ⭐ #{promedioValoraciones} (#{cantidadValoraciones} voto#{cantidadValoraciones > 1 ? 's' : ''})
              else
                span
                  | ⭐ Sin votos

              form.form-like(action=`/likes/${publicacion.id}` method='POST')
                button.btn-like(type='submit')
                  | 👍 #{cantidadLikes}

              if publicacion.createdAt
                span
                  | #{tiempoRelativo(publicacion.createdAt)}

            div.valoracion.mt-3
              if currentUser
                if currentUser.id !== publicacion.usuarioId
                  - const yaValoro = archivo.Valoracions && archivo.Valoracions.some(v => v.usuarioId === currentUser.id)

                  if yaValoro
                    p.text-muted
                      | Ya valoraste esta imagen.
                  else
                    form.form-valoracion(action=`/valoraciones/${archivo.id}` method='POST')
                      select(name='valor' required)
                        option(value='')
                          | ¿Qué te pareció?
                        option(value='1')
                          | ⭐
                        option(value='2')
                          | ⭐⭐
                        option(value='3')
                          | ⭐⭐⭐
                        option(value='4')
                          | ⭐⭐⭐⭐
                        option(value='5')
                          | ⭐⭐⭐⭐⭐

                      button.btn.btn-sm.btn-warning(type='submit')
                        | Valorar


        - const etiquetasPublicacion = publicacion.Etiquetas || publicacion.Etiqueta || []

        if etiquetasPublicacion.length > 0
          div.etiquetas
            each etiqueta in etiquetasPublicacion
              span.badge
                | ##{etiqueta.nombre}

        div.interes.mt-3
          if currentUser
            if currentUser.id !== publicacion.usuarioId
              form(action=`/intereses/${publicacion.id}` method='POST')
                button.btn.btn-sm.btn-info(type='submit')
                  | Me interesa
            else
              p.text-muted
                | Publicación propia.

        if currentUser && colecciones && colecciones.length > 0
          div.colecciones.mt-3
            h5
              | Guardar en colección

            each coleccion in colecciones
              form(
                action=`/colecciones/${coleccion.id}/agregar/${publicacion.id}`
                method='POST'
                style='display:inline-block; margin-right: 5px;'
              )
                button.btn.btn-sm.btn-secondary(type='submit')
                  | #{coleccion.nombre}

        div.comentarios.mt-3
          h5
            | Comentarios

          if publicacion.Comentarios && publicacion.Comentarios.length > 0
            each comentario in publicacion.Comentarios
              div.comentario-home
                strong= comentario.Usuario ? comentario.Usuario.nombre : 'Usuario'

                p= comentario.contenido

                if currentUser && currentUser.id !== comentario.usuarioId
                  - const yaDenuncioComentario = comentario.DenunciaComentarios && comentario.DenunciaComentarios.some(function(d) { return d.usuarioId === currentUser.id; })

                  if yaDenuncioComentario
                    small.text-muted
                      | Comentario denunciado.
                  else
                    form(action=`/denuncias-comentarios/${comentario.id}` method='POST')
                      button.btn-accion-secundaria(type='submit')
                        | Denunciar comentario

          if currentUser
            if publicacion.comentarios_habilitados
              form.form-comentario(action=`/comentarios/${publicacion.id}` method='POST')
                textarea.form-control(
                  name='contenido'
                  rows='2'
                  placeholder='Escribí un comentario...'
                  required
                )

                button.btn.btn-sm.btn-primary.mt-2(type='submit')
                  | Comentar
            else
              p.text-muted
                | Comentarios deshabilitados.

        div.acciones-publicacion
          if currentUser && currentUser.id === publicacion.usuarioId
            form(
              action=`/publicaciones/${publicacion.id}/modificar-estado-comentarios`
              method='POST'
            )
              if publicacion.comentarios_habilitados
                button.btn-accion-secundaria(type='submit')
                  | Deshabilitar comentarios
              else
                button.btn-accion-secundaria(type='submit')
                  | Habilitar comentarios

          if currentUser && currentUser.id !== publicacion.usuarioId
            - const yaDenuncio = publicacion.Denuncia && publicacion.Denuncia.some(d => d.usuarioId === currentUser.id)

            if yaDenuncio
              span.text-muted
                | Publicación denunciada.
            else
              a.btn-accion-secundaria(href=`/denuncias/${publicacion.id}`)
                | Denunciar publicación

  else
    if busqueda
      p
        | No se encontraron publicaciones con esos filtros.
    else
      p
        | Todavía no hay publicaciones cargadas.