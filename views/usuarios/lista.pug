extends ../layout

block content
  h1 Usuarios

  a(href='/usuarios/nuevo') Nuevo usuario

  table
    thead
      tr
        th Nombre
        th Email
        th DNI
        th Estado
        th Fecha registro

    tbody
      each usuario in usuarios
        tr
          td #{usuario.nombre}
          td #{usuario.email}
          td #{usuario.dni}

          td
            if usuario.estado === 'inactivo'
              span.text-danger Inactivo
            else
              span.text-success Activo

          td #{usuario.fecha_registro.toLocaleDateString()}

  if error
    p.error #{error}