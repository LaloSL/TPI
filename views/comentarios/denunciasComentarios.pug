extends ../layout.pug

block content

  .denuncias-container

    .denuncias-card

      h1 Denuncias de comentarios

      if denuncias && denuncias.length > 0

        each denuncia in denuncias

          article.denuncia-item

            p
              strong Comentario:
              |  #{denuncia.Comentario.contenido}

            p
              strong Usuario denunciado:
              |  #{denuncia.Comentario.Usuario.nombre}

            p
              strong Motivo:
              - const motivoLimpio = denuncia.motivo.replace(/_/g, ' ')
              |  #{motivoLimpio.charAt(0).toUpperCase() + motivoLimpio.slice(1)}

            p
              strong Descripción:
              |  #{denuncia.descripcion}

            form(
              action='/denuncias-comentarios/eliminar/' + denuncia.Comentario.id,
              method='POST'
            )
              button.btn-danger(type='submit')
                | Eliminar comentario

      else

        p.sin-denuncias
          | No hay denuncias de comentarios.