extends layout.pug

block content

  - function tiempoRelativo(fecha) {
  -   const ahora = new Date();
  -   const publicada = new Date(fecha);
  -   const diferencia = ahora - publicada;
  -   const minutos = Math.floor(diferencia / 60000);
  -   const horas = Math.floor(minutos / 60);
  -   const dias = Math.floor(horas / 24);
  -   if (minutos < 1) return 'Recién';
  -   if (minutos < 60) return `Hace ${minutos} min`;
  -   if (horas < 24) return `Hace ${horas} h`;
  -   if (dias < 7) return `Hace ${dias} día${dias > 1 ? 's' : ''}`;
  -   return publicada.toLocaleDateString('es-AR');
  - }

  h1 Mis colecciones

  hr

  h2 Crear nueva colección

  if error
    p(style='color: red;') #{error}

  form(action='/colecciones', method='POST')

    div
      label(for='nombre')
        | Nombre de la colección

      br

      input#nombre(
        type='text'
        name='nombre'
        placeholder='Ej: Autos clásicos'
        required
      )

    br

    button.btn(type='submit')
      | Crear colección

  hr

  h2 Colecciones creadas

  if colecciones && colecciones.length > 0

    each coleccion in colecciones

      article.coleccion

        h3 #{coleccion.nombre}

        if coleccion.createdAt

          p
            strong Creada:
            |  #{tiempoRelativo(coleccion.createdAt)}

        a.btn(href=`/colecciones/${coleccion.id}`)
          | Ver colección

        form(
          action=`/colecciones/${coleccion.id}/eliminar`
          method='POST'
        )
          button.btn(type='submit')
            | Eliminar

        hr

  else

    p Todavía no creaste colecciones.