extends layout.pug

block content

  h1 Mis colecciones

  hr

  h2 Crear nueva colección

  if error
    p(style='color: red;') #{error}

  form(action='/colecciones', method='POST')

    div
      label(for='nombre')
        | Nombre de la colección

      br

      input#nombre(
        type='text'
        name='nombre'
        placeholder='Ej: Autos clásicos'
        required
      )

    br

    button.btn(type='submit')
      | Crear colección

  hr

  h2 Colecciones creadas

  if colecciones && colecciones.length > 0

    each coleccion in colecciones

      article.coleccion

        h3 #{coleccion.nombre}

        if coleccion.createdAt

          p
            strong Creada:
            |  #{coleccion.createdAt}

        a.btn(href=`/colecciones/${coleccion.id}`)
          | Ver colección

        form(
          action=`/colecciones/${coleccion.id}/eliminar`
          method='POST'
        )
          button.btn(type='submit')
            | Eliminar

        hr

  else

    p Todavía no creaste colecciones.