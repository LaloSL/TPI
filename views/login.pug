extends layout

block content
  h1 Iniciar Sesión

  if error
    .error-message= error

  form(action='/login', method='POST')
    div.login-row
      label(for='dni') DNI:
      input(type='text', id='dni', name='dni', required)

    div.login-row
      label(for='password') Contraseña:
      input(type='password', id='password', name='password', required)

    button(type='submit') Ingresar

  p
    a(href='/recuperar') ¿Olvidaste tu contraseña?

  p
    | ¿No tenés cuenta? 
    a(href='/registro') Registrate