extends ../layout

block content

  .form-container

    if currentUser
      h1 Registrar nuevo usuario
    else
      h1 Crear cuenta

    form.form-usuario(
      action=currentUser ? '/usuarios/nuevo' : '/registro'
      method='POST'
    )

      .campo-form
        label(for='nombre') Nombre
        input#nombre(type='text', name='nombre', required)

      .campo-form
        label(for='email') Email
        input#email(type='email', name='email', required)

      .campo-form
        label(for='dni') DNI
        input#dni(type='text', name='dni', required)

      .campo-form
        label(for='password') Contraseña
        input#password(
          type='password'
          name='password'
          required
          minlength='6'
          placeholder='Mínimo 6 caracteres'
        )

      button.btn(type='submit') Registrar

    if error
      p.error #{error}

    if success
      p.success #{success}